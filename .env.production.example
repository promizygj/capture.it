NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Public URL of the app (used in emails, Slack messages and CI links)
APP_URL=https://qa.example.com
# Set to false only when serving over plain HTTP (e.g. a local trial without TLS)
COOKIE_SECURE=true
WORKER_CONCURRENCY=2
# Email notifications & password recovery (smtp://user:pass@host:587)
SMTP_URL=
MAIL_FROM="Capture.It <no-reply@example.com>"
# Optional: enables AI failure analysis (falls back to rule-based analysis when empty)
ANTHROPIC_API_KEY=
# AI failure analysis is enabled when both values are set
ANTHROPIC_MODEL=
